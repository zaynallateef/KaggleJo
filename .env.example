# Python backend. Production mode starts empty instead of seeding sample people.
KAGGLEJO_MODE=demo
KAGGLEJO_DB=data/kagglejo.db
PORT=8000
# Optional: browser API origin for separate frontend hosting. Omit for same-origin.
# VITE_API_URL=https://your-api.example.com
# KAGGLEJO_ALLOWED_ORIGIN=https://your-frontend.example.com
# Kaggle credentials are only needed by the operator's official Kaggle CLI.
# Configure those through Kaggle's documented authentication, never in VITE_ vars.
# Free hosting: npm run build:pages selects static data mode automatically.
# Store KAGGLE_API_TOKEN only in GitHub Actions repository secrets for that workflow.
